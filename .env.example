# Postgres (Neon). Sem isso, em desenvolvimento o app usa um banco local em .pglite/.
# Use a URL *pooled* do Neon. O app grava só no schema "pokedex".
DATABASE_URL=

# 32+ caracteres aleatórios: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Protege /api/refresh (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>"). Opcional: sem ele só o botão funciona.
CRON_SECRET=
